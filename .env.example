# Copy to .env, fill in, `chmod 600 .env`. `docker compose` reads it automatically.
# DEV: `docker compose up -d` (compose.override.yaml adds reload + Mailpit + exposed ports).
# PROD: `docker compose -f compose.yaml up -d` (override excluded).

# ─────────────────────────── prod: domain + TLS ───────────────────────────
# Point an A/AAAA record at this box first. Caddy provisions the cert on first boot.
# Uncomment ALL of these together: the app refuses to boot once it looks public
# (ENVIRONMENT=prod, or an https PUBLIC_BASE_URL) unless COOKIE_SECURE is true, the three
# auth secrets below are distinct non-default values, S3 / SMTP / Groq are real, and the
# legal details below are filled in.
# HTTP_PORT and HTTPS_PORT must be 80 and 443: Let's Encrypt only checks those, so on any
# other port Caddy never gets a certificate.
# DOMAIN=clips.example.com
# ACME_EMAIL=you@example.com
# PUBLIC_BASE_URL=https://clips.example.com
# COOKIE_SECURE=true
# ENVIRONMENT=prod
# HTTP_PORT=80
# HTTPS_PORT=443

# Dev leaves HTTP_PORT/HTTPS_PORT unset: compose then publishes Caddy on :8000 / :8443
# (web direct on :8001), so nothing on the dev machine needs ports 80/443.

# ─────────────────────────── prod: legal pages + sign-up ───────────────────────────
# Printed on /terms, /privacy and /copyright. The first four are required once public.
# See "Before you let anyone in" in DEPLOY.md.
# SUPPORT_EMAIL=help@clips.example.com
# LEGAL_NAME=Your name or company
# LEGAL_ADDRESS=Street, town, country
# LEGAL_JURISDICTION=Germany        # the law the Terms are governed by
# COPYRIGHT_EMAIL=                  # takedown notices; empty = SUPPORT_EMAIL
# LEGAL_EU_REPRESENTATIVE=          # only if you need one (GDPR Art. 27)
# HOSTING_PROVIDER=netcup (Germany or Austria)   # named on /privacy
# LEGAL_REVIEWED=true               # removes the "draft" banner, once a lawyer has checked them
# INVITE_ONLY=true                  # only emails added in Admin > Invites can sign up

# ─────────────────────────── object storage (all media) ───────────────────────────
# Required — compose refuses to start without these. Every video, clip, waveform and
# thumbnail lives here; nothing is stored on local disk.
#
# DEV: compose.override.yaml runs an S3 mock (service `minio`, port 9090) and creates the
# bucket for you. These four values work as-is.
S3_ENDPOINT_URL=http://minio:9090
S3_BUCKET=kappacut
S3_ACCESS_KEY_ID=kappacut
S3_SECRET_ACCESS_KEY=kappacut-dev-secret
S3_REGION=auto
#
# PROD (Cloudflare R2 — $0.015/GB/month, no egress charge):
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=kappacut
# S3_ACCESS_KEY_ID=<R2 access key>
# S3_SECRET_ACCESS_KEY=<R2 secret key>
# S3_REGION=auto
# Set a lifecycle rule on the bucket expiring the `uploads/` prefix and incomplete
# multipart uploads after 24h — that replaces the old stale-upload sweep.

# ─────────────────────────── database ───────────────────────────
POSTGRES_USER=kappacut
POSTGRES_PASSWORD=            # `openssl rand -hex 24`
POSTGRES_DB=kappacut

# ─────────────────────────── engine key (shared, server-side) ───────────────────────────
GROQ_API_KEY=                 # console.groq.com — free tier
ANTHROPIC_API_KEY=            # optional; leave blank for Groq-only

# ─────────────────── image-gen providers (AI thumbnails, optional) ───────────────────
# Real per-image spend, gated behind app/credits.py — not free-tier like Groq. Set either
# or both; generate_thumbnail() routes to whichever configured provider is currently
# performing best (success rate, then latency) and falls back automatically on failure.
TOGETHER_API_KEY=             # api.together.ai — cheapest verified option, ~$0.015/image
REPLICATE_API_KEY=            # replicate.com — fallback provider

# ─────────────────────────── auth secrets ───────────────────────────
# three DISTINCT values — `openssl rand -hex 32` each. Left blank, compose falls back to
# the checked-in dev placeholders (fine locally, refused in prod — see the block above).
JWT_SECRET=
VERIFICATION_TOKEN_SECRET=
RESET_PASSWORD_TOKEN_SECRET=

# ─────────────────────────── email (verification / reset) ───────────────────────────
# dev: the Mailpit container catches everything (UI on http://localhost:8025)
# prod: a transactional SMTP provider (Resend / Postmark / Brevo / SES). The app refuses to
# boot publicly while SMTP_HOST is localhost/Mailpit or SMTP_FROM is @localhost. Resend
# (free: 3,000/month, 100/day) after verifying your domain:
#   SMTP_HOST=smtp.resend.com  SMTP_PORT=465  SMTP_TLS=true  SMTP_USER=resend
#   SMTP_PASSWORD=<API key>    SMTP_FROM=Kappacut <no-reply@clips.example.com>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Kappacut <no-reply@localhost>
# true = implicit TLS (port 465). false = plain connect, upgraded with STARTTLS whenever the
# server offers it (port 587, what most providers document)
SMTP_TLS=false

# ─────────────────────────── free-plan quotas (optional overrides) ───────────────────────────
# QUOTA_MINUTES_PER_MONTH=60
# QUOTA_MAX_UPLOAD_BYTES=2147483648   # also tusd's -max-size (compose.yaml)
# QUOTA_STORAGE_BYTES=5368709120
# QUOTA_RENDERS_PER_DAY=40
# QUOTA_PROJECTS=25
# RENDER_MAX_CLIP_SECONDS=600       # longest single clip a render may cut
# RENDER_MAX_FPS=30                 # 60 fps sources are cut at 30 (~a third less CPU); 0 = keep source fps
# PRESIGN_VIDEO_TTL_SECONDS=21600   # how long a <video>'s signed URL lasts (an editing session)
# WORKER_CONCURRENCY=2
# FFMPEG_THREADS=0           # 0 = ffmpeg auto-detects (fine at concurrency 1). Once
#                             # WORKER_CONCURRENCY > 1, set this so
#                             # WORKER_CONCURRENCY * FFMPEG_THREADS ~= vCPU count, e.g. on a
#                             # 4-vCPU box: WORKER_CONCURRENCY=2, FFMPEG_THREADS=2 — otherwise
#                             # every concurrent render fights for every core and renders get
#                             # slower and less predictable the more users hit it at once.
# GROQ_TOKENS_PER_MINUTE=8000 # free tier; a paid key allows 250000 per model - set ~200000
# AGENT_DAILY_CAP=50         # AI editor messages per user per day; admins have no cap
# AGENT_MODEL=openai/gpt-oss-120b  # re-run tests/agent_eval.py before changing it
# RETENTION_WARN_DAYS=30
# RETENTION_DELETE_DAYS=37    # 0 disables
# RETENTION_UNVERIFIED_DAYS=14 # accounts that never confirmed their email; 0 disables
# BACKUP_KEEP=7               # 0 disables the nightly pg_dump
# DISK_MIN_FREE_PCT=4
